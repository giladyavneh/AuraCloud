# Base URL of the api-server. Override per environment.
# Local dev: http://localhost:3000
# Staging / production: set to the deployed api-server URL
VITE_API_BASE_URL=http://localhost:3000

# Where an AI client reaches the mcp-server. Bundled into the install command shown in Settings.
VITE_MCP_SERVER_URL=http://localhost:3001/mcp
