# Required — MongoDB Atlas connection string (provided via repo root .env symlink or client env)
MONGO_URI=
# Required — email of the AuraCloud customer this MCP instance acts as
MCP_USER_EMAIL=
# HTTP mode only — required; same secret the api-server signs access tokens with
JWT_SECRET=
# HTTP mode only — this server's public resource identifier, as advertised to clients
MCP_SERVER_URL=http://localhost:3001/mcp
# HTTP mode only — the api-server that issues the access tokens
ISSUER_URL=http://localhost:3000
